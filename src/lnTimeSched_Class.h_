#pragma once
#include <Arduino.h>
#include <time.h>

class lnTimeSched {
private:
    lnTimeClock* m_clock;

    struct tm m_tm;
    uint8_t  m_lastSecond = 255;
    uint8_t  m_lastMinute = 255;
    uint8_t  m_lastHour   = 255;
    uint64_t m_lastModulo = 0;

    void updateTime();

public:
    lnTimeSched(lnTimeClock* clock);

    void update();

    bool onSecond();
    bool onMinute();
    bool onHour();

    bool onModulo(uint64_t sec);
    bool onModuloHMS(uint8_t H, uint8_t M, uint8_t S);

    bool at_HMS(uint8_t H, uint8_t M, uint8_t S);
};